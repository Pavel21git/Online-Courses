# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.log

# База данных (локально)
db.sqlite3
*.sqlite3

# Виртуальное окружение
venv/
.venv/

# Секреты/конфиги
.env
!.env.example

# IDE/редактор
.vscode/
.idea/

# Тесты/линтеры/типизация
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Сборка/кэш
dist/
build/
*.egg-info/

# Django collectstatic (СТАТИЧЕСКИЙ ВЫВОД)
# Оставляй app/static в репо, игнорь только STATIC_ROOT.
# Если у тебя STATIC_ROOT=staticfiles — оставь так:
staticfiles/

# Медиа-загрузка пользователей
media/

# Кэш внутри миграций (сами миграции коммитим!)
**/migrations/__pycache__/
